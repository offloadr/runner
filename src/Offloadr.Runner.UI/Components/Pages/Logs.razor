@page "/logs"
@inherits SupervisorComponent
@implements IAsyncDisposable
@inject IJSRuntime JS
@inject ISnackbar Snackbar

<PageTitle>Logs - Offloadr Runner</PageTitle>

<MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Wrap="Wrap.Wrap" Class="mb-3">
    <MudText Typo="Typo.h5" HtmlTag="h1">Logs</MudText>
    <MudStack Row="true" Spacing="2">
        <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.ContentCopy" OnClick="CopyAsync">Copy</MudButton>
        <SaveDiagnosticsButton />
    </MudStack>
</MudStack>

<MudText Typo="Typo.body2" Class="mud-text-secondary mb-3">
    Image downloads and the runner's output since this app started. The log follows new lines while you are at the bottom; scroll up to stop it.
    Diagnostics are a text file for Offloadr support: this log, the app's checks of Docker and the GPU, and your settings.
    They never hold the runner key. Read the file before you send it, since the log can name your models and files.
</MudText>

<MudPaper Outlined="true" Class="pa-4 runner-fill-card">
    @{
        // One snapshot per render: lines arrive on another thread, so reading the count twice could disagree.
        var lines = Supervisor.LogLines;
        _logRendered = lines.Count > 0;
    }
    @if (!_logRendered)
    {
        <MudText Class="mud-text-secondary">Image downloads and runner output appear here once the runner starts.</MudText>
    }
    else
    {
        <pre @ref="_log" class="runner-log runner-log-fill" tabindex="0" aria-label="Runner log">@string.Join('\n', lines)</pre>
    }
</MudPaper>

@code {
    private ElementReference _log;
    private bool _logRendered;
    private IJSObjectReference? _module;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // What this render drew, not the live count: a first line may have arrived since, with no log element yet.
        if (!_logRendered)
        {
            return;
        }

        try
        {
            _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./_content/Offloadr.Runner.UI/logs.js");
            // Does nothing for a log it already follows; picks up the log once its first line appears.
            await _module.InvokeVoidAsync("follow", _log);
        }
        catch (JSDisconnectedException)
        {
            // The window closed.
        }
        catch (JSException)
        {
            // Following new lines is a convenience; the log still shows without it.
        }
    }

    private async Task CopyAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", string.Join('\n', Supervisor.LogLines));
            Snackbar.Add("Copied the log. The runner key is never included.", Severity.Success);
        }
        catch (JSException ex)
        {
            Snackbar.Add($"Could not copy: {ex.Message}", Severity.Error);
        }
    }

    public async ValueTask DisposeAsync()
    {
        // Blazor calls only DisposeAsync on a component that has both; the base's Dispose stops its updates.
        Dispose();
        if (_module is not null)
        {
            try
            {
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
                // The window closed.
            }
        }
    }
}
