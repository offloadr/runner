@page "/"
@inherits SupervisorComponent
@inject IRunnerSettingsStore SettingsStore
@inject NavigationManager Navigation
@inject SetupPrompt SetupPrompt

<PageTitle>Offloadr Runner</PageTitle>

<MudStack Spacing="3" Class="runner-fill">
    <MudPaper Outlined="true" Class="pa-4">
        <StatusHero />
        @if (EnvironmentChecks.NeedsSetup(SettingsStore.Current) && View.Fault is null)
        {
            <MudAlert Severity="Severity.Info" Class="mt-3">
                <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Wrap="Wrap.Wrap" Spacing="3">
                    <span>Finish setting up: the runner needs your runner key from Offloadr.</span>
                    <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary" OnClick="@(() => Navigation.NavigateTo("setup"))">Set up</MudButton>
                </MudStack>
            </MudAlert>
        }
    </MudPaper>

    <MudGrid Spacing="3">
        <MudItem xs="12" md="6">
            <MudPaper Outlined="true" Class="pa-4" Style="height: 100%">
                <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                    <MudText Typo="Typo.h6" HtmlTag="h2">This computer</MudText>
                    <MudButton Size="Size.Small" Variant="Variant.Text" StartIcon="@Icons.Material.Filled.Refresh"
                               Disabled="@View.IsActive" OnClick="Supervisor.RequestRefresh">Check again</MudButton>
                </MudStack>
                <MudStack Spacing="2" Class="mt-2">
                    <CheckRow Check="EnvironmentChecks.Docker(View)" />
                    <CheckRow Check="EnvironmentChecks.HostGpu(View, SettingsStore.Current.SelectedGpuUuid)" />
                    <CheckRow Check="EnvironmentChecks.GpuInContainers(View)">
                        <MudButton Size="Size.Small" Variant="Variant.Text" Disabled="@(_checkingGpu || View.Engine?.Available != true)"
                                   OnClick="CheckGpuAsync">@(_checkingGpu ? "Checking…" : "Check")</MudButton>
                    </CheckRow>
                    <CheckRow Check="EnvironmentChecks.RunnerKey(SettingsStore.Current)" />
                </MudStack>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" md="6">
            <MudPaper Outlined="true" Class="pa-4" Style="height: 100%">
                <MudText Typo="Typo.h6" HtmlTag="h2">Runner</MudText>
                <MudSimpleTable Dense="true" Elevation="0" Class="mt-2 runner-facts">
                    <tbody>
                        <tr><th scope="row">Editor</th><td>@(Template?.Label ?? "Not chosen yet")</td></tr>
                        <tr><th scope="row">Chosen by</th><td>@PlanSource</td></tr>
                        <tr><th scope="row">Session</th><td>@(View.RunnerStatus is null ? "–" : View.HasActiveSession ? "In use" : "Idle")</td></tr>
                        <tr><th scope="row">Agent version</th><td title="@View.RunnerStatus?.Version">@(SupervisorView.ShortVersion(View.RunnerStatus?.Version) ?? "–")</td></tr>
                        <tr><th scope="row">Restarts</th><td>@View.Restarts</td></tr>
                    </tbody>
                </MudSimpleTable>
                @if (Template is not null)
                {
                    <details class="runner-details mt-3">
                        <summary>Image details</summary>
                        <MudSimpleTable Dense="true" Elevation="0" Class="mt-1 runner-facts">
                            <tbody>
                                <tr><th scope="row">Image</th><td class="runner-check-detail">@Template.Image</td></tr>
                                <tr><th scope="row">Digest</th><td class="runner-check-detail">@(Digest ?? "–")</td></tr>
                                <tr><th scope="row">Image ID</th><td class="runner-check-detail">@(View.Image?.Id ?? "–")</td></tr>
                            </tbody>
                        </MudSimpleTable>
                    </details>
                }
            </MudPaper>
        </MudItem>
    </MudGrid>

    @* Takes the height the window has left: a taller window shows more of the log, not a longer page. *@
    <MudPaper Outlined="true" Class="pa-4 runner-fill-card">
        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
            <MudText Typo="Typo.h6" HtmlTag="h2">Recent log</MudText>
            <MudLink Href="logs">All logs</MudLink>
        </MudStack>
        @if (Supervisor.LogLines.Count == 0)
        {
            <MudText Typo="Typo.body2" Class="mud-text-secondary mt-2">Image downloads and runner output appear here once the runner starts.</MudText>
        }
        else
        {
            <div class="runner-log-fill runner-log-tail mt-2">
                <pre class="runner-log">@string.Join('\n', Supervisor.LogLines.TakeLast(TailLines))</pre>
            </div>
        }
    </MudPaper>
</MudStack>

@code {
    private bool _checkingGpu;

    // Enough to fill a tall window; Logs has the rest.
    private const int TailLines = 60;

    private LaunchTemplate? Template => View.ActiveTemplate ?? (View.Plan ?? BuiltInLaunchPlanCatalog.Plan()).Choose(SettingsStore.Current);

    private string? Digest => View.Image?.RepoDigest is { } digest && digest.Contains('@') ? digest[(digest.IndexOf('@') + 1)..] : null;

    private string PlanSource => View.Plan?.Source switch
    {
        LaunchPlanSource.ControlPlane => "Offloadr, from your editor selection",
        LaunchPlanSource.BuiltIn => "Your choice in Settings",
        LaunchPlanSource.Unreachable => "Your choice in Settings, while Offloadr cannot be reached",
        _ => "–",
    };

    protected override void OnInitialized()
    {
        base.OnInitialized();
        // The first time the app opens without a key, it opens on Setup; Skip for now stays skipped.
        if (SetupPrompt.TryOffer(SettingsStore.Current))
        {
            Navigation.NavigateTo("setup");
        }
    }

    private async Task CheckGpuAsync()
    {
        _checkingGpu = true;
        try
        {
            await Supervisor.CheckGpuAccessAsync();
        }
        finally
        {
            _checkingGpu = false;
        }
    }
}
