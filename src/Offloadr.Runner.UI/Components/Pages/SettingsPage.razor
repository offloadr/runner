@page "/settings"
@inherits SupervisorComponent
@inject RunnerSettingsEditor SettingsEditor
@inject IHostActions Host
@inject ISnackbar Snackbar
@inject IDialogService Dialogs

<PageTitle>Settings - Offloadr Runner</PageTitle>

<NavigationLock OnBeforeInternalNavigation="ConfirmLeavingAsync" />

<MudText Typo="Typo.h5" HtmlTag="h1" Class="mb-3">Settings</MudText>

<MudPaper Outlined="true" Class="pa-4">
    <MudStack Spacing="3">
        @* Side by side in a wide window, so the page fits it without scrolling. *@
        <MudGrid Spacing="3">
            <MudItem xs="12" md="6">
                <MudStack Spacing="3">
                    <MudStack Spacing="1">
                        <MudTextField T="string" @bind-Value="_runnerKey" Immediate="true" Label="Runner key" Variant="Variant.Outlined"
                                      InputType="@(_showKey ? InputType.Text : InputType.Password)"
                                      Adornment="Adornment.End" AdornmentIcon="@(_showKey ? Icons.Material.Filled.VisibilityOff : Icons.Material.Filled.Visibility)"
                                      AdornmentAriaLabel="Show or hide the key" OnAdornmentClick="@(() => _showKey = !_showKey)"
                                      HelperText="Create a personal runner key under Settings in the Offloadr web app. It is stored encrypted on this computer." />
                        <div>
                            <MudButton Size="Size.Small" Variant="Variant.Text" EndIcon="@Icons.Material.Filled.OpenInNew"
                                       OnClick="OpenOffloadrAsync">Open Offloadr</MudButton>
                        </div>
                    </MudStack>

                    <MudSelect T="string" @bind-Value="_editorTemplate" Label="Editor" Variant="Variant.Outlined"
                               HelperText="@EditorHelp">
                        @foreach (var template in Templates)
                        {
                            <MudSelectItem Value="@template.EditorTemplate">@template.Label</MudSelectItem>
                        }
                    </MudSelect>

                    <MudStack Row="true" AlignItems="AlignItems.Start" Spacing="2">
                        <MudTextField T="string" @bind-Value="_modelsDirectory" Immediate="true" Label="Models folder (optional)" Variant="Variant.Outlined" Clearable="true"
                                      HelperText="Your model files. Offloadr uses the ones that match what a workflow needs, and saves the models it downloads here." />
                        @if (Host.CanPickFolder)
                        {
                            <MudButton Variant="Variant.Outlined" Class="mt-2" OnClick="PickModelsFolderAsync">Browse</MudButton>
                        }
                    </MudStack>

                    <MudStack Spacing="0">
                        <MudSwitch T="bool" @bind-Value="_downloadModels" Color="Color.Primary" Label="Download models this computer does not have"
                                   Disabled="@(string.IsNullOrWhiteSpace(_modelsDirectory) && !_downloadModels)" />
                        <MudText Typo="Typo.caption" Class="mud-text-secondary ml-14">
                            @if (string.IsNullOrWhiteSpace(_modelsDirectory))
                            {
                                <text>Choose a models folder first: downloaded models are saved there, where you can see them, delete them and use them in other apps.</text>
                            }
                            else
                            {
                                <text>Downloaded models are saved in your models folder. They are often several gigabytes each. When this is off, workflows can use only the models already there.</text>
                            }
                        </MudText>
                    </MudStack>
                </MudStack>
            </MudItem>

            <MudItem xs="12" md="6">
                <MudStack Spacing="3">
                    <MudStack Spacing="0">
                        <MudSwitch T="bool" @bind-Value="_autoStart" Color="Color.Primary" Label="Make this GPU available to Offloadr when this app opens" />
                        <MudText Typo="Typo.caption" Class="mud-text-secondary ml-14">@AutoStartHelp</MudText>
                    </MudStack>

                    @if (Host.CanStartAtSignIn)
                    {
                        <MudStack Spacing="0">
                            <MudSwitch T="bool" @bind-Value="_startAtSignIn" Color="Color.Primary" Label="Open this app in the notification area when I sign in to Windows" />
                            <MudText Typo="Typo.caption" Class="mud-text-secondary ml-14">Together with the switch above, your GPU is available to Offloadr after every sign-in.</MudText>
                        </MudStack>
                    }

                    <MudStack Spacing="0">
                        <MudSwitch T="bool" @bind-Value="_keepAwake" Color="Color.Primary" Label="Keep this computer awake while a session runs on it" />
                        <MudText Typo="Typo.caption" Class="mud-text-secondary ml-14">Sleep would cut the session off. The display can still turn off, and the computer sleeps again once the session ends.</MudText>
                    </MudStack>
                </MudStack>
            </MudItem>
        </MudGrid>

        <MudExpansionPanels Outlined="true" Elevation="0">
            <MudExpansionPanel Text="Advanced">
                <MudStack Spacing="3">
                    <MudTextField T="string" @bind-Value="_origin" Immediate="true" Label="Offloadr address" Variant="Variant.Outlined"
                                  HelperText="Change this only to use another Offloadr environment." />
                    <MudTextField T="string" @bind-Value="_engineExecutable" Immediate="true" Label="Docker or podman executable" Variant="Variant.Outlined" Clearable="true"
                                  HelperText="Leave empty to find Docker automatically." />
                    @if (ShowsGpuChoice)
                    {
                        <MudSelect T="string" @bind-Value="GpuChoice" Label="GPU" Variant="Variant.Outlined"
                                   Error="@SavedGpuMissing" ErrorText="This GPU is not on this computer now. Choose another one, or All GPUs."
                                   HelperText="@GpuHelp">
                            <MudSelectItem Value="@AllGpus">All GPUs</MudSelectItem>
                            @foreach (var gpu in ChoosableGpus)
                            {
                                <MudSelectItem Value="@gpu.Uuid">@GpuLabel(gpu)</MudSelectItem>
                            }
                            @if (SavedGpu is null && !string.IsNullOrWhiteSpace(_gpuUuid))
                            {
                                <MudSelectItem Value="@_gpuUuid">@(SavedGpuMissing ? $"Not found: {_gpuUuid}" : _gpuUuid)</MudSelectItem>
                            }
                        </MudSelect>
                    }
                    <MudTextField T="string" @bind-Value="_comfyUiArguments" Immediate="true" Label="Extra ComfyUI arguments" Variant="Variant.Outlined" Clearable="true"
                                  Error="@(ComfyUiArgumentsProblem is not null)" ErrorText="@ComfyUiArgumentsProblem"
                                  HelperText="Added to ComfyUI's command line, such as --lowvram --preview-method auto. The runner sets the network, folder and GPU flags itself." />
                    <MudTextField T="string" @bind-Value="_forgeNeoArguments" Immediate="true" Label="Extra Forge Neo arguments" Variant="Variant.Outlined" Clearable="true"
                                  Error="@(ForgeNeoArgumentsProblem is not null)" ErrorText="@ForgeNeoArgumentsProblem"
                                  HelperText="Added to Forge Neo's command line, such as --use-ck-attention. The runner sets the network, folder and GPU flags itself." />
                </MudStack>
            </MudExpansionPanel>
        </MudExpansionPanels>

        @if (_problems.Count > 0)
        {
            <MudAlert Severity="Severity.Warning" Dense="true">
                @foreach (var problem in _problems)
                {
                    <div>@problem</div>
                }
            </MudAlert>
        }

        <MudStack Row="true" Justify="Justify.FlexEnd" AlignItems="AlignItems.Center" Spacing="3">
            @if (HasChanges)
            {
                <MudText Typo="Typo.body2" Class="mud-text-secondary" aria-live="polite">Unsaved changes</MudText>
            }
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="_saving" OnClick="SaveAsync">Save</MudButton>
        </MudStack>
    </MudStack>
</MudPaper>

@code {
    private string? _runnerKey;
    private string? _editorTemplate;
    private string? _modelsDirectory;
    private string? _origin;
    private string? _engineExecutable;
    private string? _comfyUiArguments;
    private string? _forgeNeoArguments;
    private bool _autoStart;
    private bool _downloadModels;
    private bool _keepAwake = true;
    private bool _startAtSignIn;
    private bool _showKey;
    private bool _saving;
    private IReadOnlyList<string> _problems = [];

    // What the page last loaded or saved, to tell whether leaving would lose changes.
    private SettingsForm _saved = null!;
    private bool _savedStartAtSignIn;

    private SettingsForm Form => new(_runnerKey, _editorTemplate, _modelsDirectory, _origin, _engineExecutable, _autoStart, _downloadModels, _keepAwake, _comfyUiArguments, _forgeNeoArguments, _gpuUuid);

    // Stands for no choice in the select, which then saves a blank GPU.
    private const string AllGpus = "all";

    private string? _gpuUuid;

    private string GpuChoice
    {
        get => string.IsNullOrWhiteSpace(_gpuUuid) ? AllGpus : _gpuUuid;
        set => _gpuUuid = value == AllGpus ? null : value;
    }

    /// <summary>The GPUs this computer has that can be chosen: those whose driver gives a UUID.</summary>
    private IReadOnlyList<HostGpu> ChoosableGpus => View.HostGpus?.Gpus.Where(gpu => gpu.Uuid is not null).ToList() ?? [];

    // Most computers have one NVIDIA GPU, with nothing to choose; a GPU chosen before stays visible to change it.
    private bool ShowsGpuChoice => ChoosableGpus.Count > 1 || !string.IsNullOrWhiteSpace(_gpuUuid);

    private HostGpu? SavedGpu => ChoosableGpus.FirstOrDefault(gpu => string.Equals(gpu.Uuid, _gpuUuid?.Trim(), StringComparison.OrdinalIgnoreCase));

    private bool SavedGpuMissing => !string.IsNullOrWhiteSpace(_gpuUuid) && ChoosableGpus.Count > 0 && SavedGpu is null;

    private string GpuHelp => string.IsNullOrWhiteSpace(_gpuUuid)
        ? "The runner can see every NVIDIA GPU, and editors use the first. Choose one to keep the others free for other work."
        : "The runner and its editor use only this GPU.";

    // Two GPUs of the same model are told apart by the start of their UUIDs.
    private string GpuLabel(HostGpu gpu)
    {
        var label = EnvironmentChecks.Describe(gpu);
        return ChoosableGpus.Count(other => EnvironmentChecks.Describe(other) == label) > 1 ? $"{label}, {gpu.Uuid![..12]}" : label;
    }

    private string? ComfyUiArgumentsProblem => RunnerSettings.EditorArgumentsProblem(RunnerSettings.ComfyUiRuntimeKind, _comfyUiArguments);

    private string? ForgeNeoArgumentsProblem => RunnerSettings.EditorArgumentsProblem(RunnerSettings.ForgeNeoRuntimeKind, _forgeNeoArguments);

    private bool HasChanges => !Form.SameAs(_saved) || _startAtSignIn != _savedStartAtSignIn;

    private IReadOnlyList<LaunchTemplate> Templates
        => View.Plan?.Source == LaunchPlanSource.ControlPlane ? View.Plan.Templates : BuiltInLaunchPlanCatalog.Templates;

    private string EditorHelp => View.Plan?.Source == LaunchPlanSource.ControlPlane
        ? "Offloadr chooses the editor you select there. This one is used only when Offloadr has not chosen one."
        : "Used only when Offloadr does not choose the editor itself, as now. Match the editor you use in Offloadr.";

    /// <summary>Said once for Settings and Setup: people read "runner" as an editor, and expect it to start.</summary>
    internal const string AutoStartHelp
        = "Starts the runner in the background, where it waits for Offloadr. The editor, such as ComfyUI, starts only when you open a session, and Offloadr chooses which.";

    protected override void OnInitialized()
    {
        base.OnInitialized();
        var form = SettingsEditor.Load();
        _runnerKey = form.RunnerKey;
        _editorTemplate = form.SelectedEditorTemplate;
        _modelsDirectory = form.LocalModelsDirectory;
        _origin = form.OffloadrApiOrigin;
        _engineExecutable = form.ContainerEngineExecutable;
        _autoStart = form.AutoStart;
        _downloadModels = form.DownloadModels;
        _keepAwake = form.KeepAwakeDuringSessions;
        _comfyUiArguments = form.ComfyUiArguments;
        _forgeNeoArguments = form.ForgeNeoArguments;
        _gpuUuid = form.GpuUuid;
        _startAtSignIn = Host.CanStartAtSignIn && Host.StartsAtSignIn;
        _saved = form;
        _savedStartAtSignIn = _startAtSignIn;
    }

    private async Task SaveAsync()
    {
        _saving = true;
        try
        {
            var form = Form;
            var result = await SettingsEditor.SaveAsync(form);
            _problems = result.Problems;
            if (!result.Saved)
            {
                Snackbar.Add(result.Error ?? "Could not save the settings.", Severity.Error);
                return;
            }

            _saved = form;
            if (Host.CanStartAtSignIn && _startAtSignIn != Host.StartsAtSignIn)
            {
                Host.SetStartAtSignIn(_startAtSignIn);
            }

            _savedStartAtSignIn = _startAtSignIn;

            Snackbar.Add(
                View.IsActive ? "Saved. The runner restarts with these settings when no session is using it." : "Saved.",
                _problems.Count == 0 ? Severity.Success : Severity.Warning);
        }
        catch (Exception ex) when (ex is IOException or UnauthorizedAccessException or System.Security.SecurityException)
        {
            Snackbar.Add($"Saved, but could not change whether the app starts at sign-in: {ex.Message}", Severity.Error);
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task PickModelsFolderAsync()
    {
        var folder = await Host.PickFolderAsync();
        if (!string.IsNullOrEmpty(folder))
        {
            _modelsDirectory = folder;
        }
    }

    private async Task ConfirmLeavingAsync(LocationChangingContext context)
    {
        if (!HasChanges)
        {
            return;
        }

        // One dialog for every navigation asked for while it is open: a later one cancels the earlier,
        // which then has nothing left to decide, and no second dialog stacks on the first.
        var confirmation = _confirmation ??= Dialogs.ShowMessageBoxAsync(
            "Discard your changes?",
            "You changed settings without saving them. Leaving this page discards those changes.",
            yesText: "Discard",
            cancelText: "Keep editing");
        var discard = await confirmation;
        if (ReferenceEquals(_confirmation, confirmation))
        {
            _confirmation = null;
        }

        if (!context.CancellationToken.IsCancellationRequested && discard != true)
        {
            context.PreventNavigation();
        }
    }

    private Task<bool?>? _confirmation;

    private Task OpenOffloadrAsync()
        => Host.OpenExternalAsync(string.IsNullOrWhiteSpace(_origin) ? RunnerSettings.DefaultOffloadrApiOrigin : _origin);
}
