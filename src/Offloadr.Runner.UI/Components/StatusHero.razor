@inherits SupervisorComponent

@* The runner's state at a glance: what it is doing, the one button that changes it, progress and problems. *@
<MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Wrap="Wrap.Wrap" Spacing="3">
    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3">
        <MudIcon Icon="@StateIcon" Color="@StateColor" Size="Size.Large" aria-hidden="true" />
        <div>
            <MudText Typo="@TitleTypo" HtmlTag="@TitleTag">@View.StateTitle</MudText>
            <MudText Typo="Typo.body2" Class="mud-text-secondary" aria-live="polite">@Summary</MudText>
        </div>
    </MudStack>
    @if (View.IsActive || View.State == SupervisorState.Stopping)
    {
        <MudStack Row="true" Spacing="2">
            @if (View.State == SupervisorState.Running && !Supervisor.RunnerWanted)
            {
                @* A container still serves, but the computer is no longer offered (another app took over, say). *@
                <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.PlayArrow"
                           Disabled="Starting" OnClick="StartAsync">Offer this GPU again</MudButton>
            }
            <MudButton Variant="Variant.Outlined" Color="Color.Error" StartIcon="@Icons.Material.Filled.Stop"
                       Disabled="@(View.State == SupervisorState.Stopping)" OnClick="Supervisor.RequestStop">Stop runner</MudButton>
        </MudStack>
    }
    else
    {
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.PlayArrow"
                   Disabled="Starting" OnClick="StartAsync">@StartLabel</MudButton>
    }
</MudStack>
@if (View.Fault is { } fault)
{
    @* A retry is the same start as the button above: on Setup it saves the page's answers first. *@
    <FaultCard Fault="fault" Waiting="@(View.State != SupervisorState.Faulted)" OnOpenSettings="OnOpenSettings" OnStart="StartAsync" Class="mt-3" />
}
@if (View.PullProgress is { Fraction: { } fraction } pull)
{
    <MudProgressLinear Value="@(fraction * 100)" Color="Color.Primary" Class="mt-3" aria-label="Image download" />
    <MudText Typo="Typo.caption" Class="mud-text-secondary">@pull.Summary</MudText>
}
else if (View.State is SupervisorState.Pulling or SupervisorState.Checking or SupervisorState.Starting or SupervisorState.Stopping)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mt-3" aria-label="@View.StateTitle" />
    @if (View.PullProgress is { } measuring)
    {
        <MudText Typo="Typo.caption" Class="mud-text-secondary">@measuring.Summary</MudText>
    }
}
@if (View.Interruption is { } interruption)
{
    <MudAlert Severity="Severity.Warning" Dense="true" Class="mt-3" ShowCloseIcon="true" CloseIconClicked="@(_ => Supervisor.DismissInterruption())">@interruption</MudAlert>
}
@if (View.LaunchFailure is { } launchFailure)
{
    <MudAlert Severity="Severity.Warning" Dense="true" Class="mt-3">@launchFailure.Title: @launchFailure.Message</MudAlert>
}
@if (View.HasActiveSession)
{
    <MudAlert Severity="Severity.Info" Dense="true" Class="mt-3">An editor session is using this runner. Stopping now interrupts it.</MudAlert>
}
@if (View.Plan?.Notice is { } notice && View.IsActive)
{
    <MudAlert Severity="Severity.Normal" Dense="true" Class="mt-3">@notice</MudAlert>
}

@code {
    /// <summary>What Start does instead of starting the runner at once; Setup saves its answers first.</summary>
    [Parameter]
    public EventCallback OnStart { get; set; }

    [Parameter]
    public string StartLabel { get; set; } = "Start runner";

    [Parameter]
    public EventCallback OnOpenSettings { get; set; }

    /// <summary>The page's own heading, or a heading inside one.</summary>
    [Parameter]
    public bool IsPageHeading { get; set; } = true;

    private bool Starting { get; set; }

    private Typo TitleTypo => IsPageHeading ? Typo.h5 : Typo.h6;

    private string TitleTag => IsPageHeading ? "h1" : "h3";

    // The card below says what is wrong and what to do.
    private string Summary => View is { State: SupervisorState.Faulted, Fault: not null }
        ? "The runner stopped. Fix the problem below, then start it again."
        : View.Message;

    private async Task StartAsync()
    {
        if (!OnStart.HasDelegate)
        {
            Supervisor.RequestStart();
            return;
        }

        Starting = true;
        try
        {
            await OnStart.InvokeAsync();
        }
        finally
        {
            Starting = false;
        }
    }

    // Success only once Offloadr can use the computer: a launcher still connecting, or refused, is not.
    private string StateIcon => View.State switch
    {
        _ when View.IsReady => Icons.Material.Filled.CheckCircle,
        SupervisorState.Faulted => Icons.Material.Filled.Error,
        SupervisorState.Stopped => Icons.Material.Filled.PauseCircle,
        _ => Icons.Material.Filled.Autorenew,
    };

    private Color StateColor => View.State switch
    {
        _ when View.IsReady => Color.Success,
        SupervisorState.Available => Color.Warning,
        SupervisorState.Faulted => Color.Error,
        SupervisorState.WaitingToRetry => Color.Warning,
        SupervisorState.Stopped => Color.Default,
        _ => Color.Primary,
    };
}
