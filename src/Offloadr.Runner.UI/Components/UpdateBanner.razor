@using Offloadr.Runner.Supervisor.Hosting
@inherits SupervisorComponent
@inject IServiceProvider Services
@inject IHostActions Host

@* Shown while a newer release downloads and once it is ready to install. *@
@if (_updates?.Status is { State: AppUpdateState.Downloading or AppUpdateState.Ready, Available: { } version } status && version != _dismissed)
{
    <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="mb-4" ShowCloseIcon="@(status.State == AppUpdateState.Ready)"
              CloseIconClicked="@(() => _dismissed = version)">
        @if (status.State == AppUpdateState.Downloading)
        {
            <span>Downloading Offloadr Runner @version.ToString(3)… @status.Percent%</span>
        }
        else
        {
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3" Wrap="Wrap.Wrap">
                <span>
                    Offloadr Runner @version.ToString(3) is ready to install. The runner keeps running while the app restarts;
                    otherwise the update installs when you quit the app.
                </span>
                <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary"
                           Disabled="@(_restarting || !_updates.CanRestartNow(View))"
                           OnClick="RestartAsync">Restart to update</MudButton>
            </MudStack>
            @if (!_updates.CanRestartNow(View))
            {
                <MudText Typo="Typo.caption" Class="runner-check-detail">The restart waits until the runner has finished starting, stopping or restarting.</MudText>
            }
        }
    </MudAlert>
}

@code {
    private AppUpdateService? _updates;
    private Version? _dismissed;
    private bool _restarting;

    protected override void OnInitialized()
    {
        base.OnInitialized();
        _updates = Services.GetService(typeof(AppUpdateService)) as AppUpdateService;
        if (_updates is not null)
        {
            _updates.Changed += OnUpdatesChanged;
        }
    }

    public override void Dispose()
    {
        if (_updates is not null)
        {
            _updates.Changed -= OnUpdatesChanged;
        }

        base.Dispose();
    }

    private void OnUpdatesChanged() => InvokeAsync(StateHasChanged);

    private async Task RestartAsync()
    {
        _restarting = true;
        try
        {
            await Host.RestartToUpdateAsync();
        }
        finally
        {
            _restarting = false;
        }
    }
}
