<Project Sdk="Microsoft.NET.Sdk">

  <!-- Container entry point: runs as PID 1 inside the runner images. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>RunnerAgent</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Offloadr.Runner.Linux\Offloadr.Runner.Linux.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Console" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Offloadr.Runner.Core" />
    <Using Include="Offloadr.Runner.Linux" />
  </ItemGroup>

  <ItemGroup>
    <TrimmerRootAssembly Include="Aria2NET" />
    <TrimmerRootAssembly Include="Newtonsoft.Json" />
  </ItemGroup>

</Project>
